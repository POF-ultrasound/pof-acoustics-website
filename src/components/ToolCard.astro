---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { url } from '../lib/url';

interface Props {
  tool: CollectionEntry<'tools'>;
}
const { tool } = Astro.props;
const t = tool.data;
---

<a class="card" href={url(`/software/${tool.id}/`)}>
  {
    t.image ? (
      <Image src={t.image} alt={t.imageAlt ?? ''} width={640} height={360} fit="cover" class="thumb" />
    ) : (
      <div class="thumb placeholder" aria-hidden="true">
        <span>{t.name}</span>
      </div>
    )
  }
  <div class="card-body">
    <span class="eyebrow">{t.kind === 'dataset' ? 'Dataset' : 'Software'}</span>
    <h3>{t.name}</h3>
    <p>{t.summary}</p>
  </div>
</a>

<style>
  .thumb {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-bottom: 1px solid var(--color-border);
  }
  .placeholder {
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 30% 40%, var(--color-accent-soft) 0 18%, transparent 19%),
      radial-gradient(circle at 70% 60%, var(--color-accent-soft) 0 10%, transparent 11%),
      var(--color-surface);
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--color-accent);
  }
  .eyebrow {
    margin: 0;
  }
</style>
