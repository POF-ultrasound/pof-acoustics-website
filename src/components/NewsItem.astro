---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { formatDate } from '../lib/url';
import Icon from './Icon.astro';

interface Props {
  post: CollectionEntry<'news'>;
  compact?: boolean;
}
const { post, compact = false } = Astro.props;
const { Content } = await render(post);
const d = post.data;
---

<article class:list={['news', { compact }]} id={compact ? undefined : post.id.split('/').pop()}>
  <time datetime={d.date.toISOString()}>{formatDate(d.date)}</time>
  <div>
    <h3>{d.title}</h3>
    <div class="body"><Content /></div>
    {
      d.link && (
        <a class="out" href={d.link}>
          {d.linkLabel ?? 'Read more'} <Icon name="external" size={14} />
        </a>
      )
    }
    {
      !compact && d.tags.length > 0 && (
        <div class="tags">
          {d.tags.map((t) => (
            <span class="tag">{t}</span>
          ))}
        </div>
      )
    }
  </div>
</article>

<style>
  .news {
    display: grid;
    gap: var(--space-1) var(--space-5);
    padding-block: var(--space-4);
    border-top: 1px solid var(--color-border);
  }
  @media (min-width: 48rem) {
    .news:not(.compact) {
      grid-template-columns: 10rem 1fr;
    }
  }
  time {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }
  h3 {
    margin: 0 0 var(--space-1);
    font-size: var(--text-lg);
  }
  .compact h3 {
    font-size: var(--text-base);
  }
  .body :global(p) {
    margin: 0 0 var(--space-2);
    color: var(--color-text-muted);
  }
  .compact .body :global(p) {
    font-size: var(--text-sm);
  }
  .out {
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .tags {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }
</style>
