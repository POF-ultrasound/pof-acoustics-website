---
// The POF logo file is white-on-transparent; we use it as a mask and fill it
// with the text colour so it follows the palette (and dark mode).
import { getImage } from 'astro:assets';
import pofLogo from '../assets/logos/pof.png';

interface Props {
  height?: number;
}
const { height = 36 } = Astro.props;
const img = await getImage({ src: pofLogo, height: height * 2, format: 'png' });
const width = Math.round((pofLogo.width / pofLogo.height) * height);
---

<span
  class="pof-logo"
  role="img"
  aria-label="Physics of Fluids"
  style={`--logo: url(${img.src}); width: ${width}px; height: ${height}px;`}></span>

<style>
  .pof-logo {
    display: inline-block;
    flex-shrink: 0;
    background-color: var(--color-text);
    -webkit-mask: var(--logo) center / contain no-repeat;
    mask: var(--logo) center / contain no-repeat;
  }
</style>
